<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<c:if test="${user != null}">
    <div class="sidebar">
        <a href="<c:url value='/clubs/profile?userId=${user.id}' />"
           class="sidebar-btn ${activePage == 'profile' ? 'active' : ''}">
            <spring:message code="title.myProfile"/>
        </a>

        <c:if test="${user.role != null and user.role.name() == 'ADMIN'}">
            <a href="<c:url value='/clubs/activity?userId=${user.id}' />"
               class="sidebar-btn ${activePage == 'clubs' ? 'active' : ''}">
                <spring:message code="title.myClubs"/>
            </a>
            <a href="<c:url value='/admin/clubs/bookings?userId=${user.id}' />"
               class="sidebar-btn ${activePage == 'clubsBookings' ? 'active' : ''}">
                <spring:message code="menu.clubReservations" text="Reservas"/>
            </a>
        </c:if>

        <a href="<c:url value='/bookings?userId=${user.id}' />" class="sidebar-btn ${activePage == 'bookings' ? 'active' : ''}">
            <spring:message code="menu.reservations" text="Reservas"/>
        </a>

        <a href="<c:url value='/logout'/>" class="sidebar-btn logout-btn">
            <i class="fa-solid fa-right-from-bracket"></i>&nbsp;&nbsp;<spring:message code="button.logout"/>
        </a>
    </div>
</c:if>
