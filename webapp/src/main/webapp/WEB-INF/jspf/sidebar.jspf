<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:if test="${user != null}">
    <div class="sidebar">
        <a href="<c:url value='/clubs/profile?userId=${user.id}' />"
           class="sidebar-btn ${activePage == 'profile' ? 'active' : ''}">Mi perfil</a>

        <c:if test="${user.role != null and user.role.name() == 'ADMIN'}">
            <a href="<c:url value='/clubs/activity?userId=${user.id}' />"
               class="sidebar-btn ${activePage == 'clubs' ? 'active' : ''}">Mis boliches</a>
        </c:if>

        <a href="#" class="sidebar-btn ${activePage == 'reservas' ? 'active' : ''}">Mis reservas</a>
        <a href="#" class="sidebar-btn ${activePage == 'ayuda' ? 'active' : ''}">Ayuda</a>
    </div>
</c:if>
