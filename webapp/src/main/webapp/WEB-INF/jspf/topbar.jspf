<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<div class="top-bar">
    <a href="<c:url value='/clubs' />" class="logo-link">
        <div class="app-title">Bling <br>&nbsp;&nbsp;Bling</div>
    </a>

    <c:if test="${not empty showRightButtons}">
        <div class="right-buttons">
            <a href="<c:url value='/clubs/new' />" class="add-club-btn">Añadir Boliche</a>

            <c:if test="${not empty user}">
                <a href="<c:url value='/clubs/profile?userId=${user.id}' />" class="profile-btn" title="Mi perfil">
                    <i class="fa-solid fa-user"></i>
                </a>
            </c:if>


            <c:if test="${empty user}">
                <a href="<c:url value='/login' />" class="login-btn">Iniciar Sesión</a>
            </c:if>

        </div>
    </c:if>
</div>
